package;

import hxp.*;
import lime.tools.*;
import sys.FileSystem;
import sys.io.File;
import haxe.io.Bytes;
import haxe.io.Path;
import haxe.ds.Map;
import haxe.xml.Printer;

using StringTools;
using tools.AnsiUtil;

@:nullSafety
class Project extends HXProject
{
  static final VERSION:String = "0.8.7";
  static final BUILD_NUMBER:Int = 102;
  static final TITLE:String = "Friday Night Funkin' Template";
  static final TITLE_MOBILE:String = "FNF: Template";
  static final PACKAGE_NAME:String = "yourname.funkin.fnf";
  static final EXECUTABLE_NAME:String = "FunkinTemplate";
  static final SOURCE_DIR:String = "source";
  static final TEMPLATES_DIR:String = "templates";
  static final PRELOADER:String = "funkin.ui.transition.preload.FunkinPreloader";
  static final MAIN_CLASS:String = "Main";
  static final COMPANY:String = "The Funkin' Crew";
  static final LANGUAGES:Array<String> = ["en"];

  static var envConfig:Null<Map<String, Dynamic>> = null;

  static final ANDROID_EXTENSIONS:Array<String> = [
    "funkin.extensions.CallbackUtil",
    "funkin.extensions.FNFCExtension",
    "funkin.extensions.AudioSession"
  ];

  static var IOS_TEAM_ID:String = "Z7G7AVNGSH";
  static var astcExcludes:Array<String> = [];

  static final PREBUILD_HX:String = "source/Prebuild.hx";
  static final POSTBUILD_HX:String = "source/Postbuild.hx";

  static final EXCLUDE_ASSETS:Array<String> = [".*", "cvs", "thumbs.db", "desktop.ini", "*.hash", "*.md"];
  static final EXCLUDE_ASSETS_WEB:Array<String> = ["*.ogg"];
  static final EXCLUDE_ASSETS_NATIVE:Array<String> = ["*.mp3"];
  static final EXCLUDE_ASSETS_CENSORED:Array<String> = ["stressCutscene.mp4", "stressPicoCutscene.mp4", "darnellCutscene.mp4"];
  static final EXCLUDE_ASSETS_UNCENSORED:Array<String> = ["stressCutscene-censored.mp4", "stressPicoCutscene-censored.mp4", "darnellCutscene-censored.mp4"];

  static final EMBED_SONGS_AUDIO:Array<String> = ["spaghetti"];

  static final WEEK_LIBRARIES:Array<String> = [
    "tutorial", "week1", "week2", "week3", "week4", "week5", "week6", "week7", "weekend1", "sserafim"
  ];

  var flagCache:Map<String, FeatureFlag> = new Map();

  public function new()
  {
    super();

    #if !target.unicode
    if (isWindowsHost())
    {
      Sys.command("chcp 65001 > nul");
    }
    #end

    envConfig = readEnvironmentFile("./.env");

    flair();
    displayTarget();
    configureApp();
    configureOutputDir();

    if (isRun() || isInstall())
    {
      return;
    }

    configureFeatureFlags();
    configureCompileDefines();
    configureIncludeMacros();
    configureCustomMacros();
    configurePolymod();
    configureHaxelibs();
    configureASTCTextures();
    configureAssets();

    if (!isLinux())
    {
      configureIcons();
    }

    if (flag("FEATURE_MOBILE_ADVERTISEMENTS").isEnabled(this))
    {
      configureAdMobKeys();
    }

    if (isAndroid())
    {
      configureAndroid();
    }

    if (isIOS())
    {
      configureIOS();
    }

    if (isCPP())
    {
      buildHxCppTools();
    }

    if (!(isDisplay() || isCleanCommand()))
    {
      checkLibraries();
    }
  }

  function flair()
  {
    info("Friday Night Funkin' - " + VERSION);
    info("Initializing build...");
    info("Git Branch:     " + getGitBranch());
    info("Git Commit:     " + getGitCommit());
    info("Git Modified?   " + getGitModified());
    info("Display?        " + isDisplay());
  }

  function configureApp()
  {
    this.meta.title = isMobile() ? TITLE_MOBILE : TITLE;
    this.meta.version = VERSION;
    this.meta.packageName = PACKAGE_NAME;
    this.meta.company = COMPANY;

    this.app.main = MAIN_CLASS;
    this.app.file = EXECUTABLE_NAME;
    this.app.preloader = PRELOADER;

    this.sources.push(SOURCE_DIR);
    this.templatePaths.push(TEMPLATES_DIR);

    this.preBuildCallbacks.push(buildHaxeCLICommand(PREBUILD_HX));
    this.postBuildCallbacks.push(buildHaxeCLICommand(POSTBUILD_HX));

    this.languages = LANGUAGES;
    this.meta.buildNumber = Std.string(BUILD_NUMBER);

    this.window.fps = 60;
    this.window.width = 1280;
    this.window.height = 720;
    this.window.background = isDebugFunctionsRequested() ? 0xFFFF00FF : 0xFF000000;

    this.window.hardware = true;
    this.window.vsync = false;
    this.window.allowHighDPI = !isMac();

    if (isWeb())
    {
      this.window.resizable = true;
    }

    if (isDesktop())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = false;
      this.window.resizable = true;
      this.window.vsync = false;
    }

    if (isMobile())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = true;
      this.window.resizable = false;
      this.window.borderless = true;
      this.window.width = 0;
      this.window.height = 0;
    }

    if (isAndroid())
    {
      configureAndroidWindowFlags();
    }

    if (isIOS())
    {
      config.set("ios.non-exempt-encryption", "false");
      config.set("ios.team-id", IOS_TEAM_ID);
      config.set("ios.deployment", "16.0");
    }
  }

  function isDebugFunctionsRequested():Bool
  {
    return this.haxedefs.exists("FEATURE_DEBUG_FUNCTIONS") || isDebug();
  }

  function configureAndroidWindowFlags()
  {
    if (this.haxedefs.exists("EXCLUDE_ARMV7"))
    {
      this.excludeArchitectures.push(Architecture.ARMV7);
    }

    if (isRelease())
    {
      if (envConfig != null)
      {
        keystore = new Keystore();
        keystore.path = Std.string(envConfig.get('KEYSTORE_PATH'));
        keystore.alias = Std.string(envConfig.get('KEYSTORE_ALIAS'));
        keystore.password = Std.string(envConfig.get('KEYSTORE_PASSWORD'));
      }

      if (isBundle())
      {
        config.set("android.gradle-project-directory", "bin-bundle");
      }
    }
  }

  function displayTarget()
  {
    switch (this.target)
    {
      case Platform.WINDOWS:
        info('Target Platform: Windows');
      case Platform.MAC:
        info('Target Platform: MacOS');
      case Platform.LINUX:
        info('Target Platform: Linux');
      case Platform.ANDROID:
        info('Target Platform: Android');
      case Platform.IOS:
        info('Target Platform: IOS');
      case Platform.HTML5:
        info('Target Platform: HTML5');
      default:
        error('Unsupported platform (got ${target})');
    }

    switch (this.platformType)
    {
      case PlatformType.DESKTOP:
        info('Target Platform Type: Desktop');
      case PlatformType.MOBILE:
        info('Target Platform Type: Mobile');
      case PlatformType.WEB:
        info('Target Platform Type: Web');
      case PlatformType.CONSOLE:
        info('Target Platform Type: Console');
      default:
        error('Unknown platform type (got ${platformType})');
    }

    if (isWeb())
    {
      info('Target Language: JavaScript (HTML5)');
    }
    else if (isCPP())
    {
      info('Target Language: C++');
    }
    else
    {
      error('Unsupported target language!');
    }

    for (arch in this.architectures)
    {
      switch (arch)
      {
        case Architecture.X86:
          info('Target Architecture: x86');
        case Architecture.X64:
          info('Target Architecture: x64');
        case Architecture.ARMV7:
          info('Target Architecture: ARMv7');
        case Architecture.ARM64:
          info('Target Architecture: ARM64');
        case null:
          if (!isWeb())
          {
            error('Unsupported architecture (got null on non-web platform)');
          }
          else
          {
            info('Target Architecture: Web');
          }
        default:
          error('Unsupported architecture (got ${arch})');
      }
    }
  }

  function registerFeatureFlags():Array<FeatureFlagDef>
  {
    return [
      {name: "GITHUB_BUILD", enabled: (p) -> false},
      {name: "EXCLUDE_ARMV7", enabled: (p) -> false},
      {name: "HARDCODED_CREDITS", enabled: (p) -> true},
      {name: "UNLOCK_EVERYTHING", enabled: (p) -> true},
      {name: "EMBED_ASSETS", enabled: (p) -> p.isWeb()},
      {name: "PRELOAD_ALL", enabled: (p) -> !p.isWeb()},
      {name: "REDIRECT_ASSETS_FOLDER", enabled: (p) -> p.isDebug() && p.isDesktop()},
      {name: "TESTING_ADS", enabled: (p) -> p.isDebug() && p.flag("FEATURE_MOBILE_ADVERTISEMENTS").isEnabled(p)},
      {name: "CENSOR_EXPLETIVES", enabled: (p) -> p.isMobile()},
      {name: "FORCE_BLEND_SHADER", enabled: (p) -> p.isAndroid()},
      {name: "FEATURE_FUNKVIS", enabled: (p) -> true},
      {name: "FEATURE_LOG_TRACE", enabled: (p) -> true},
      {name: "FEATURE_DEBUG_FILE_LOGGING", enabled: (p) -> p.flag("FEATURE_DEBUG_FUNCTIONS").isEnabled(p)},
      {name: "FEATURE_NAUGHTYNESS", enabled: (p) -> true},
      {name: "FEATURE_OPEN_URL", enabled: (p) -> true},
      {name: "FEATURE_PARTIAL_SOUNDS", enabled: (p) -> true},
      {name: "FEATURE_POLYMOD_MODS", enabled: (p) -> true},
      {name: "FEATURE_VIDEO_PLAYBACK", enabled: (p) -> true},
      {name: "FEATURE_VIDEO_SUBTITLES", enabled: (p) -> p.flag("FEATURE_VIDEO_PLAYBACK").isEnabled(p) && !p.isWeb()},
      {name: "FEATURE_DEBUG_FUNCTIONS", enabled: (p) -> p.isDebug() || p.flag("GITHUB_BUILD").isEnabled(p)},
      {name: "FEATURE_RESULTS_DEBUG", enabled: (p) -> p.isDebug() || p.flag("GITHUB_BUILD").isEnabled(p)},
      {name: "FEATURE_DISCORD_RPC", enabled: (p) -> p.isDesktop() && !p.flag("FEATURE_DEBUG_FUNCTIONS").isEnabled(p)},
      {name: "FEATURE_LOST_FOCUS_VOLUME", enabled: (p) -> p.isDesktop()},
      {name: "FEATURE_NEWGROUNDS", enabled: (p) -> true},
      {name: "FEATURE_NEWGROUNDS_DEBUG", enabled: (p) -> false},
      {
        name: "FEATURE_NEWGROUNDS_TESTING_MEDALS",
        enabled: (p) -> p.flag("FEATURE_NEWGROUNDS").isEnabled(p) && p.flag("FEATURE_DEBUG_FUNCTIONS").isEnabled(p)
      },
      {name: "FEATURE_NEWGROUNDS_AUTOLOGIN", enabled: (p) -> p.flag("FEATURE_NEWGROUNDS").isEnabled(p) && p.isWeb()},
      {name: "FEATURE_NEWGROUNDS_EVENTS", enabled: (p) -> p.flag("FEATURE_NEWGROUNDS").isEnabled(p)},
      {name: "FEATURE_DEBUG_MENU", enabled: (p) -> !(p.isWeb() || p.isMobile())},
      {name: "FEATURE_ANIMATION_EDITOR", enabled: (p) -> !(p.isWeb() || p.isMobile())},
      {name: "FEATURE_CHART_EDITOR", enabled: (p) -> !(p.isWeb() || p.isMobile())},
      {name: "FEATURE_STAGE_EDITOR", enabled: (p) -> !(p.isWeb() || p.isMobile())},
      {
        name: "FEATURE_HAXEUI",
        enabled: (p) -> p.flag("FEATURE_ANIMATION_EDITOR").isEnabled(p)
          || p.flag("FEATURE_CHART_EDITOR").isEnabled(p)
          || p.flag("FEATURE_STAGE_EDITOR").isEnabled(p)
      },
      {name: "FEATURE_LAG_ADJUSTMENT", enabled: (p) -> !p.isWeb()},
      {name: "FEATURE_SCREENSHOTS", enabled: (p) -> p.isDesktop()},
      {name: "FEATURE_FILE_DROP", enabled: (p) -> !p.isMobile()},
      {name: "FEATURE_TOUCH_HERE_TO_PLAY", enabled: (p) -> p.isWeb()},
      {name: "FEATURE_HAPTICS", enabled: (p) -> p.isMobile()},
      {name: "FEATURE_TOUCH_CONTROLS", enabled: (p) -> p.isMobile()},
      {name: "FEATURE_MOBILE_ADVERTISEMENTS", enabled: (p) -> (p.isMobile() && p.isRelease()) && envConfig != null},
      {name: "FEATURE_MOBILE_IAP", enabled: (p) -> (p.isMobile() && p.isRelease()) && envConfig != null},
      {name: "FEATURE_MOBILE_IAR", enabled: (p) -> p.isMobile() && p.isRelease()},
      {name: "FEATURE_MOBILE_WEBVIEW", enabled: (p) -> p.isMobile() && p.flag("FEATURE_NEWGROUNDS").isEnabled(p)},
      {name: "FEATURE_MOBILE_AGESIGNALS", enabled: (p) -> p.isMobile() && p.isRelease()},
      {name: "FEATURE_GHOST_TAPPING", enabled: (p) -> p.isMobile()},
      {name: "FEATURE_COMPRESSED_TEXTURES", enabled: (p) -> p.isMobile() && p.isRelease() && !p.isIOSSimulator()},
      {name: "FEATURE_DEBUG_DISPLAY", enabled: (p) -> !p.isMobile() || p.flag("FEATURE_DEBUG_FUNCTIONS").isEnabled(p)},
    ];
  }

  public function flag(name:String):FeatureFlag
  {
    var cached = flagCache.get(name);
    if (cached != null) return cached;

    var created:FeatureFlag = name;
    flagCache.set(name, created);
    return created;
  }

  function configureFeatureFlags()
  {
    var flagDefs:Array<FeatureFlagDef> = registerFeatureFlags();

    for (def in flagDefs)
    {
      flag(def.name).apply(this, def.enabled(this));
    }

    renderFlagsTable();
  }

  function renderFlagsTable():Void
  {
    var enabledWidth:Int = 0;
    var disabledWidth:Int = 0;
    var enabledFlags:Array<String> = [];
    var disabledFlags:Array<String> = [];
    var unicodeCheck:String = "✓ ";
    var unicodeCross:String = "× ";

    for (flagStr in this.haxedefs.keys())
    {
      if (!flagStr.startsWith(FeatureFlag.INVERSE_PREFIX))
      {
        enabledWidth = Std.int(Math.max(flagStr.length + 3, enabledWidth));
        enabledFlags.push(unicodeCheck + flagStr);
      }
      else
      {
        disabledWidth = Std.int(Math.max(flagStr.length, disabledWidth));
        disabledFlags.push(unicodeCross + flagStr.substring(FeatureFlag.INVERSE_PREFIX.length));
      }
    }

    enabledFlags.sort(function(a, b) return a > b ? 1 : -1);
    disabledFlags.sort(function(a, b) return a > b ? 1 : -1);

    var horizontalDivider:String = "".rpad("-", enabledWidth + disabledWidth);

    info(horizontalDivider);
    info("FEATURE FLAGS");
    info('Enabled Flags $unicodeCheck'.rpad(" ", enabledWidth + 5) + 'Disabled Flags $unicodeCross');
    info(horizontalDivider);

    while (enabledFlags.length > 0 || disabledFlags.length > 0)
    {
      var outputLine:String = "";

      if (enabledFlags.length > 0) outputLine += enabledFlags.shift();

      outputLine = outputLine.rpad(" ", enabledWidth + 5);
      outputLine += "| ";

      if (disabledFlags.length > 0) outputLine += disabledFlags.shift() ?? "";

      info(outputLine);
    }

    info(horizontalDivider);
  }

  function configureCompileDefines()
  {
    setHaxedef("funkin", VERSION);
    setHaxedef("openfl-enable-handle-error");
    setHaxedef("lime_disable_assets_version");
    setHaxedef("HXCPP_CHECK_POINTER");
    setHaxedef("HXCPP_STACK_LINE");
    setHaxedef("HXCPP_STACK_TRACE");
    setHaxedef("hscriptPos");

    if (flag("FEATURE_DEBUG_FUNCTIONS").isDisabled(this))
    {
      setHaxedef("FLX_NO_DEBUG");
      setHaxedef("analyzer-optimize");
    }

    if (flag("FEATURE_LOG_TRACE").isDisabled(this))
    {
      setHaxedef("no-traces");
    }

    setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");
    setHaxedef("haxeui_no_mouse_reset");
    setHaxedef("haxeui_focus_out_on_click");
    setHaxedef("haxeui_dont_impose_base_class");

    if (isRelease())
    {
      setHaxedef("NAPE_RELEASE_BUILD");
    }

    setHaxedef("message.reporting", "pretty");

    if (flag("FEATURE_DEBUG_TRACY").isEnabled(this))
    {
      setHaxedef("HXCPP_TELEMETRY");
      setHaxedef("HXCPP_TRACY");
      setHaxedef("HXCPP_TRACY_MEMORY");
      setHaxedef("HXCPP_TRACY_ON_DEMAND");
      setHaxedef("absolute-paths");
    }
  }

  function configureIncludeMacros()
  {
    addHaxeFlag("-dce no");

    addHaxeMacro("include('funkin', true, ['funkin.mobile.*', 'funkin.ui.debug.anim.*', 'funkin.ui.debug.charting.*', 'funkin.ui.debug.stage.*', 'funkin.ui.debug.stageeditor.*', 'funkin.ui.haxeui.*'])");

    if (isMobile())
    {
      addHaxeMacro("include('funkin.mobile')");
    }

    if (flag("FEATURE_HAXEUI").isEnabled(this))
    {
      if (flag("FEATURE_ANIMATION_EDITOR").isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.anim')");
      }

      if (flag("FEATURE_CHART_EDITOR").isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.charting')");
      }

      if (flag("FEATURE_STAGE_EDITOR").isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.stage')");
        addHaxeMacro("include('funkin.ui.debug.stageeditor')");
      }

      addHaxeMacro("include('funkin.ui.haxeui')");
      addHaxeMacro("include('haxe.ui.backend.flixel.components')");
      addHaxeMacro("include('haxe.ui.core')");
      addHaxeMacro("include('haxe.ui.components')");
      addHaxeMacro("include('haxe.ui.containers')");
      addHaxeMacro("include('haxe.ui.containers.dialogs')");
      addHaxeMacro("include('haxe.ui.containers.menus')");
      addHaxeMacro("include('haxe.ui.containers.properties')");
    }

    addHaxeMacro("include('animate')");
    addHaxeMacro("include('openfl')");
    addHaxeMacro("include('lime', true, ['lime.tools.*', 'lime._internal.*'])");
    addHaxeMacro("include('flixel', true, [ 'flixel.addons.editors.spine.*', 'flixel.addons.nape.*', 'flixel.system.macros.*', 'flixel.addons.tile.FlxRayCastTilemap' ])");
  }

  function configureCustomMacros()
  {
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxBasic())', 'flixel.FlxBasic')");
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxSprite())', 'flixel.FlxSprite')");
  }

  function configureOutputDir()
  {
    var buildDir = 'export/${isDebug() ? 'debug' : 'release'}';

    if (flag("FEATURE_DEBUG_TRACY").isEnabled(this)) buildDir += "-tracy";

    info('Output directory: $buildDir');

    buildDir += "/";

    app.path = buildDir;
  }

  @:nullSafety(Off)
  function pushConfigXmlChild(key:String, xml:Xml):Void
  {
    var entry = config.get(key);
    var rendered = Printer.print(xml, true);

    if (entry.xmlChildren != null)
    {
      entry.xmlChildren.push(rendered);
    }
    else
    {
      entry.xmlChildren = [rendered];
    }
  }

  @:nullSafety(Off)
  function pushConfigArrayString(key:String, value:String):Void
  {
    var existing = config.getArrayString(key);

    config.set(key, existing != null ? existing.concat([value]) : [value]);
  }

  function configureAndroid()
  {
    javaPaths.push(Path.join([SOURCE_DIR, 'funkin/external/android/java']));

    final modsFolderProvider:Xml = Xml.createElement('provider');
    modsFolderProvider.set('android:authorities', '$PACKAGE_NAME.docprovider');
    modsFolderProvider.set('android:name', 'funkin.provider.DataFolderProvider');
    modsFolderProvider.set('android:grantUriPermissions', 'true');
    modsFolderProvider.set('android:exported', 'true');
    modsFolderProvider.set('android:permission', 'android.permission.MANAGE_DOCUMENTS');

    final providerIntentFilter:Xml = Xml.createElement('intent-filter');
    final providerAction:Xml = Xml.createElement('action');
    providerAction.set('android:name', 'android.content.action.DOCUMENTS_PROVIDER');
    providerIntentFilter.addChild(providerAction);
    modsFolderProvider.addChild(providerIntentFilter);

    pushConfigXmlChild('android.application', modsFolderProvider);

    final intentFilter:Xml = Xml.createElement('intent-filter');
    final action:Xml = Xml.createElement('action');
    action.set('android:name', 'android.intent.action.VIEW');
    intentFilter.addChild(action);

    final intentFilterCategories:Array<String> = ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"];

    for (categoryName in intentFilterCategories)
    {
      final category:Xml = Xml.createElement('category');
      category.set('android:name', categoryName);
      intentFilter.addChild(category);
    }

    final intentFilterDatas:Map<String, Array<String>> = [
      "android:mimeType" => ["application/zip"],
      "android:scheme" => ["file", "content"],
      "android:pathPattern" => [".*\\.fnfc", ".*\\..*\\.fnfc", ".*\\..*\\..*\\.fnfc", ".*\\..*\\..*\\..*\\.fnfc", ".*\\..*\\..*\\..*\\..*\\.fnfc"]
    ];

    for (key => values in intentFilterDatas)
    {
      for (value in values)
      {
        final data:Xml = Xml.createElement("data");
        data.set(key, value);
        intentFilter.addChild(data);
      }
    }

    pushConfigXmlChild('android.activity', intentFilter);

    final extensions:Null<Array<String>> = config.getArrayString('android.extension');

    for (extension in ANDROID_EXTENSIONS)
    {
      if (extensions == null || extensions != null && extensions.indexOf(extension) == -1)
      {
        config.push("android.extension", extension);
      }
    }
  }

  function configureIOS()
  {
    final documentTypes:String = File.getContent("documentTypes.plist");

    pushConfigArrayString('ios.info-plist-children', documentTypes);
  }

  function configurePolymod()
  {
    setHaxedef("POLYMOD_SCRIPT_EXT", ".hscript");
    setHaxedef("POLYMOD_SCRIPT_LIBRARY", "scripts");
    setHaxedef("POLYMOD_ROOT_PATH", "scripts/");
    setHaxedef("POLYMOD_APPEND_FOLDER", "_append");
    setHaxedef("POLYMOD_MERGE_FOLDER", "_merge");
    setHaxedef("POLYMOD_MOD_METADATA_FILE", "_polymod_meta.json");
    setHaxedef("POLYMOD_MOD_ICON_FILE", "_polymod_icon.png");

    if (isDebug())
    {
      setHaxedef("POLYMOD_DEBUG");
    }
  }

  function configureHaxelibs()
  {
    addHaxelib('flixel');
    addHaxelib('flixel-addons');

    if (flag("FEATURE_HAXEUI").isEnabled(this))
    {
      addHaxelib('haxeui-core');
      addHaxelib('haxeui-flixel');
    }

    addHaxelib('polymod');
    addHaxelib('flixel-animate');
    addHaxelib('json2object');
    addHaxelib('jsonpath');
    addHaxelib('jsonpatch');
    addHaxelib('thx.core');
    addHaxelib('thx.semver');

    if (isDebug() && isCPP())
    {
      addHaxelib('hxcpp-debug-server');
    }

    if ((isDesktop() || isMobile()) && flag("FEATURE_VIDEO_PLAYBACK").isEnabled(this))
    {
      addHaxelib('hxvlc');
    }

    if (isAndroid())
    {
      addHaxelib('extension-androidtools');
    }

    if (isLinux())
    {
      addHaxelib('hxgamemode');
    }

    if (flag("FEATURE_DISCORD_RPC").isEnabled(this))
    {
      addHaxelib('hxdiscord_rpc');
    }

    if (flag("FEATURE_NEWGROUNDS").isEnabled(this))
    {
      addHaxelib('newgrounds');
    }

    if (flag("FEATURE_FUNKVIS").isEnabled(this))
    {
      addHaxelib('funkin.vis');
      addHaxelib('grig.audio');
    }

    if (flag("FEATURE_PARTIAL_SOUNDS").isEnabled(this))
    {
      addHaxelib('FlxPartialSound');
    }

    if (flag("FEATURE_HAPTICS").isEnabled(this))
    {
      addHaxelib('extension-haptics');
    }

    if (flag("FEATURE_MOBILE_ADVERTISEMENTS").isEnabled(this))
    {
      addHaxelib('extension-admob');
    }

    if (flag("FEATURE_MOBILE_IAP").isEnabled(this))
    {
      addHaxelib('extension-iapcore');
    }

    if (flag("FEATURE_MOBILE_IAR").isEnabled(this))
    {
      addHaxelib('extension-iarcore');
    }

    if (flag("FEATURE_MOBILE_WEBVIEW").isEnabled(this))
    {
      addHaxelib('extension-webviewcore');
    }

    if (flag("FEATURE_MOBILE_AGESIGNALS").isEnabled(this))
    {
      addHaxelib('extension-agesignals');
    }
  }

  function configureAssets()
  {
    if (!(isDisplay() || isCleanCommand()))
    {
      clearAssets();
    }

    var exclude = EXCLUDE_ASSETS.concat(isWeb() ? EXCLUDE_ASSETS_WEB : EXCLUDE_ASSETS_NATIVE);
    var shouldPreload = flag("PRELOAD_ALL").isEnabled(this);
    var shouldEmbed = flag("EMBED_ASSETS").isEnabled(this);

    exclude = exclude.concat(flag("CENSOR_EXPLETIVES").isEnabled(this) ? EXCLUDE_ASSETS_CENSORED : EXCLUDE_ASSETS_UNCENSORED);

    info(shouldEmbed ? 'Embedding assets into executable...' : 'Including assets alongside executable...');

    addAssetLibrary("default", shouldEmbed, true);
    addAssetPath("assets/preload", "assets", "default", ["*"], exclude, shouldEmbed, "assets");

    if (!flag("HARDCODED_CREDITS").isEnabled(this))
    {
      addAsset("assets/exclude/data/credits.json", "assets/data/credits.json", "default", shouldEmbed);
    }

    if (!flag("FEATURE_ANIMATION_EDITOR").isEnabled(this)) removeAssetPath('assets/preload/data/ui/animation-editor', "default");
    if (!flag("FEATURE_CHART_EDITOR").isEnabled(this)) removeAssetPath('assets/preload/data/ui/chart-editor', "default");
    if (!flag("FEATURE_STAGE_EDITOR").isEnabled(this)) removeAssetPath('assets/preload/data/ui/stage-editor', "default");

    addAssetPath("assets/fonts", null, "default", ["*"], exclude, true, "assets");

    addAssetLibrary("songs", shouldEmbed, shouldPreload);
    addAssetPath("assets/songs", "assets/songs", "songs", ["*"], exclude, shouldEmbed, "assets");

    for (song in EMBED_SONGS_AUDIO)
    {
      removeAssetPath('assets/songs/$song');
      addAssetPath('assets/songs/$song', 'assets/songs/$song', "songs", ["*"], exclude, true, "assets");
    }

    addAssetLibrary("shared", shouldEmbed, shouldPreload);
    addAssetPath("assets/shared", "assets/shared", "shared", ["*"], exclude, shouldEmbed, "assets");

    if (flag("FEATURE_VIDEO_PLAYBACK").isEnabled(this))
    {
      addAssetLibrary("videos", false, shouldPreload);
      addAssetPath("assets/videos", "assets/videos", "videos", ["*"], exclude, false, "assets");
    }

    for (week in WEEK_LIBRARIES)
    {
      addAssetLibrary(week, shouldEmbed, shouldPreload);
      addAssetPath('assets/$week', 'assets/$week', week, ["*"], exclude, shouldEmbed, "assets");
    }

    addAssetLibrary("art", false, false);
    addAsset("art/readme.txt", "do NOT readme.txt", "art", false);
    addAsset("LICENSE.md", "LICENSE.md", "art", false);
    addAsset("CHANGELOG.md", "CHANGELOG.md", "art", false);

    info(shouldEmbed ? 'Done embedding assets.' : 'Done including assets.');
  }

  function clearAssets():Void
  {
    if (!isBuild()) return;

    var exportPath:Null<String> = app.path ?? "";
    var platform:String = !isMac() ? Std.string(this.target) : 'macos';
    var basePath:String = Path.join([exportPath, platform, "bin"]);
    var assetsPath:String = "";

    switch (platformType)
    {
      case PlatformType.DESKTOP:
        assetsPath = isMac()
          ? Path.join([basePath, '${this.app.file}.app', "Contents", "Resources", "assets"])
          : Path.join([basePath, "assets"]);
      case PlatformType.MOBILE:
        if (isAndroid() && !isBundle())
        {
          assetsPath = Path.join([basePath, "app", "src", "main", "assets", "assets"]);
        }
        else if (isIOS())
        {
          assetsPath = Path.join([exportPath, platform, '${this.app.file}', "assets", "assets"]);
        }
        else
        {
          return;
        }
      default:
        return;
    }

    if (sys.FileSystem.exists(assetsPath))
    {
      info('Deleting assets folder from export folder ($assetsPath)');
      deleteDirectoryRecursive(assetsPath);
    }
    else
    {
      info('Assets folder does not exist ($assetsPath)');
    }
  }

  function deleteDirectoryRecursive(path:String):Void
  {
    if (!sys.FileSystem.exists(path)) return;

    for (file in sys.FileSystem.readDirectory(path))
    {
      var fullPath:String = Path.join([path, file]);
      if (sys.FileSystem.isDirectory(fullPath))
      {
        deleteDirectoryRecursive(fullPath);
      }
      else
      {
        sys.FileSystem.deleteFile(fullPath);
      }
    }

    sys.FileSystem.deleteDirectory(path);
  }

  function configureIcons()
  {
    info('Configuring application icons...');

    if (isAndroid())
    {
      adaptiveIcon = new AdaptiveIcon('art/icons/android/', true);
    }
    else if (isIOS())
    {
      addIcon("art/icons/bf-iOS-Default-20x20@2x.png", 40);
      addIcon("art/icons/bf-iOS-Default-20x20@3x.png", 60);
      addIcon("art/icons/bf-iOS-Default-29x29.png", 29);
      addIcon("art/icons/bf-iOS-Default-29x29@2x.png", 58);
      addIcon("art/icons/bf-iOS-Default-29x29@3x.png", 87);
      addIcon("art/icons/bf-iOS-Default-40x40@2x.png", 80);
      addIcon("art/icons/bf-iOS-Default-60x60@2x.png", 120);
      addIcon("art/icons/bf-iOS-Default-60x60@3x.png", 180);
      addIcon("art/icons/bf-iOS-Default-1024x1024.png", 1024);
      addIcon("art/icons/bf-iOS-Default-1024x1024.png");
    }
    else
    {
      addIcon("art/icons/icon16.png", 16);
      addIcon("art/icons/icon32.png", 32);
      addIcon("art/icons/icon64.png", 64);
      addIcon("art/icons/iconOG.png");
